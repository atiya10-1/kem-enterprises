# MongoDB
MONGO_URL=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE
DB_NAME=kem_enterprises
# Canonical public website origin. Replace after purchasing the domain.
PUBLIC_SITE_URL=https://www.example.com
# Comma-separated allowed frontend origins. Never use * with credentials in production.
CORS_ORIGINS=https://www.example.com
# Authentication/storage secrets required by your deployment.
JWT_SECRET=replace-with-a-long-random-secret
